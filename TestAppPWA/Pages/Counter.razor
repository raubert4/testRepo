@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary fast-tap" style="width:120px; height:50px;" @onclick="IncrementCount">  +1  </button>
<button class="btn btn-primary fast-tap" style="width:120px; height:50px;" @onclick="IncrementCount10">  +10  </button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
    private void IncrementCount10()
    {
        currentCount += 10;
    }
}
